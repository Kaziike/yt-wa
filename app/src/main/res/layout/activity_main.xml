<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. TẦNG DƯỚI: Duyệt Trang chủ, Kênh đăng ký, Tìm kiếm... (Giữ nguyên vị trí cuộn) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kaz.litetube.view.KeepAliveWebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 2. TẦNG TRÊN: Lớp phát Video trượt đè lên (hỗ trợ kéo xuống toàn vùng video & bấm Logo thu nhỏ) -->
    <com.kaz.litetube.view.DraggablePlayerLayout
        android:id="@+id/playerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <!-- WebView chuyên dụng phát Video -->
        <com.kaz.litetube.view.KeepAliveWebView
            android:id="@+id/playerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Thanh điều khiển MiniPlayer hiển thị ở đáy khi thu nhỏ -->
        <LinearLayout
            android:id="@+id/miniPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:background="@android:color/transparent"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Ô cửa sổ trong suốt 104x58dp (viền chắn 3dp #212121 che mép topbar/tiêu đề) để lộ video thu nhỏ -->
            <View
                android:layout_width="110dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_miniplayer_video_mask" />

            <!-- Khối nền xám đen chứa thông tin video và nút điều khiển -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#212121"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="6dp">

                <!-- Tiêu đề và tên kênh -->
                <LinearLayout
                    android:id="@+id/miniPlayerInfoContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniPlayerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="LiteTube"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniPlayerChannel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Nút Play/Pause trên MiniPlayer Bar -->
                <ImageButton
                    android:id="@+id/btnMiniPlayerPlayPause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_play_pause"
                    android:src="@android:drawable/ic_media_pause"
                    android:tint="@color/white" />

                <!-- Nút Đóng [X] trên MiniPlayer Bar -->
                <ImageButton
                    android:id="@+id/btnMiniPlayerClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_close_player"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </com.kaz.litetube.view.DraggablePlayerLayout>

    <!-- Thanh tiến trình tải trang siêu mỏng -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/red"
        android:visibility="gone" />

    <!-- Container chứa Video Fullscreen khi nhấn nút phóng to -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

</FrameLayout>
